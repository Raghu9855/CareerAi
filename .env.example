# -----------------------------------------------------------------------------
# CareerAI Application Configuration
# -----------------------------------------------------------------------------

# Application
APP_NAME=CareerAI
APP_ENV=development
APP_DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Database (MySQL 8)
# Example URL: mysql+asyncmy://careerai_user:careerai_pass@127.0.0.1:3306/careerai_db
DATABASE_URL=mysql+asyncmy://careerai_user:careerai_pass@127.0.0.1:3306/careerai_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Redis (Cache, Rate Limiting & Background Tasks)
REDIS_URL=redis://127.0.0.1:6379/0

# Security & JWT Auth
# Generate secure key using: openssl rand -hex 32
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage (local | s3)
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage/uploads
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB

# AWS S3 (Used when STORAGE_BACKEND=s3)
AWS_REGION=us-east-1
AWS_S3_BUCKET=careerai-documents-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ML Configuration
MODEL_DIR=./app/ml/artifacts
DEFAULT_MODEL_VERSION=v1.0.0

# LLM Configuration (ollama | mock | groq | openai | gemini | openrouter)
#
# Primary Default: Ollama (100% Free Local - Install from https://ollama.com, then run: 'ollama run llama3.2')
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# Option B: Offline Mock Engine (Zero dependencies, used in automated tests)
# LLM_PROVIDER=mock
# LLM_MODEL=mock-llm-v1

# Option C: Groq (Free & 500+ tokens/sec: https://console.groq.com/keys)
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# Option D: OpenAI (Standard Cloud: https://platform.openai.com/api-keys)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# Option E: Google Gemini (Free Tier: https://aistudio.google.com/app/apikey)
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIzaSy...
# LLM_MODEL=gemini-1.5-flash

# RAG & Vector Store (memory | chroma | qdrant)
VECTOR_STORE_TYPE=memory
VECTOR_STORE_PATH=./storage/vector_store
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

# Rate Limiting
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=10
